{
  "manifest_version": 3,
  "name": "Visa Agency Helper",
  "version": "1.0.0",
  "description": "A document checklist and quick launcher for your visa agency work. Does not connect to any appointment website.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Visa Agency Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "options_page": "options.html"
}
